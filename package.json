{
  "name": "kuben-monorepo",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "setup": "scripts/setup.sh",
    "dev": "turbo run dev --filter=@kuben/console",
    "dev:site": "turbo run dev --filter=@kuben/site",
    "build": "turbo run build",
    "check": "turbo run check",
    "lint": "turbo run lint biome:check",
    "format": "turbo run format biome:fix",
    "test": "turbo run test",
    "gen": "turbo run gen",
    "size": "turbo run size",
    "drift": "scripts/check-drift.sh",
    "e2e": "turbo run e2e",
    "ci": "scripts/ci.sh",
    "biome:check": "bun --bun ./node_modules/.bin/biome ci .",
    "biome:fix": "bun --bun ./node_modules/.bin/biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:"
  },
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.7.0",
      "@astrojs/check": "^0.9.12",
      "@astrojs/markdown-satteri": "^0.4.5",
      "@astrojs/sitemap": "^3.7.4",
      "@astrojs/starlight": "^0.42.7",
      "@astrojs/starlight-tailwind": "^5.0.0",
      "@biomejs/biome": "2.6.2",
      "@fontsource-variable/geist-mono": "^5.3.0",
      "@fontsource-variable/inter": "^5.3.0",
      "@iconify-json/lucide": "^1.2.147",
      "@iconify-json/simple-icons": "^1.2.100",
      "@size-limit/file": "^12.1.0",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-query": "^5.104.5",
      "@tanstack/react-router": "^1.170.46",
      "@types/bun": "^1.4.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^6.1.2",
      "astro": "^7.4.2",
      "astro-icon": "^1.2.0",
      "openapi-fetch": "^0.17.0",
      "openapi-typescript": "^7.13.0",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "satteri": "^0.10.5",
      "sharp": "^0.35.5",
      "size-limit": "^12.1.0",
      "starlight-blog": "^0.30.2",
      "starlight-image-zoom": "^0.16.2",
      "starlight-links-validator": "^0.27.0",
      "starlight-llms-txt": "^0.12.0",
      "starlight-openapi": "^0.27.0",
      "tailwindcss": "^4.3.3",
      "turbo": "2.11.10",
      "typescript": "^5.9.3",
      "vite": "^8.3.0",
      "wrangler": "4.152.0"
    }
  }
}
