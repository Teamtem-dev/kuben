{
  "name": "@kuben/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun ./node_modules/.bin/vite",
    "build": "bun --bun ./node_modules/.bin/vite build",
    "preview": "bun --bun ./node_modules/.bin/vite preview",
    "check": "bun --bun ./node_modules/.bin/tsc && bun --bun ./node_modules/.bin/tsc -p tsconfig.test.json",
    "test": "bun test",
    "size": "bun --bun ./node_modules/.bin/size-limit"
  },
  "dependencies": {
    "@kuben/api-client": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@size-limit/file": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "size-limit": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "size-limit": [
    {
      "name": "JS (all chunks, brotli)",
      "path": "dist/assets/*.js",
      "limit": "200 kB"
    },
    {
      "name": "CSS (brotli)",
      "path": "dist/assets/*.css",
      "limit": "25 kB"
    }
  ]
}
