---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { Icon } from 'astro-icon/components'
import Logo from '../components/Logo.astro'
import ConsoleCard from '../components/landing/ConsoleCard.astro'
import CopyCommand from '../components/landing/CopyCommand.astro'

const helm =
  'helm install kuben oci://ghcr.io/teamtem-dev/charts/kuben --namespace kuben-system --create-namespace'
const curl = 'curl -fsSL https://raw.githubusercontent.com/Teamtem-dev/kuben/main/install.sh | bash'

const features = [
  {
    icon: 'lucide:layers',
    title: 'Isolated environments',
    body: 'Projects hold environments, environments hold apps. Every environment is its own namespace with resource quotas and a NetworkPolicy, so staging can never reach production.',
  },
  {
    icon: 'lucide:rocket',
    title: 'Deploy any image',
    body: 'Point at a container image and get a zero-downtime rollout with readiness and startup probes, autoscaling, environment variables and write-only secrets.',
  },
  {
    icon: 'lucide:history',
    title: 'Day-2 operations built in',
    body: 'Logs, restarts, numbered releases with one-click rollback, promotion between environments with a diff preview, persistent volumes and cron jobs.',
  },
  {
    icon: 'lucide:globe-lock',
    title: 'Custom domains, automatic HTTPS',
    body: 'Gateway API routes plus cert-manager certificates. One listener per hostname, HTTP redirected to HTTPS, and a domain can belong to exactly one app.',
  },
  {
    icon: 'lucide:users',
    title: 'Teams, tokens and an audit log',
    body: 'Four roles that form a strict ladder, API tokens capped at a role and scoped to a project or environment, and an append-only record of every change and every denial.',
  },
  {
    icon: 'lucide:git-branch',
    title: 'GitOps-friendly by design',
    body: 'Projects, environments, apps and releases are Kubernetes custom resources. kubectl, Argo CD and Flux work next to the UI, not against it.',
  },
]

const stats = [
  { value: '1', label: 'binary, no external services' },
  { value: '≤ 26 MiB', label: 'release binary, UI included' },
  { value: '64 Mi', label: 'memory requested by the pod' },
  { value: '5', label: 'platforms, checksummed and attested' },
]

const security = [
  'Runs as a non-root user in a distroless image, with a read-only root filesystem and every capability dropped.',
  'Session cookies are __Host- and Secure; API tokens are stored as SHA-256 hashes and compared in constant time.',
  'Login throttling is shared by all replicas. Every mutation, denial and login is audited, never a request body.',
  'Tenant namespaces enforce Pod Security “baseline”, forbid LoadBalancer and NodePort services and close ingress between environments.',
  'Every release is checksummed, attested and scanned, and each binary carries its own dependency list for auditing in place.',
]

const templates = [
  'PostgreSQL 17',
  'Redis 7',
  'MariaDB 11',
  'n8n',
  'Uptime Kuma',
  'Vaultwarden',
  'Gitea',
  'whoami',
]

const roadmap = [
  { title: 'Git builds', body: 'Build from a repository with BuildKit, without an external CI.' },
  { title: 'Preview environments', body: 'A short-lived environment for every pull request.' },
  { title: 'Scale to zero', body: 'Idle apps stop; the first request wakes them.' },
  { title: 'Single sign-on', body: 'OIDC for teams that already have an identity provider.' },
]
---

<StarlightPage
  frontmatter={{
    title: 'Kuben — a Kubernetes PaaS in a single binary',
    description:
      'Turn any Kubernetes cluster into a platform your team can use: deploy images into isolated environments with HTTPS, autoscaling, logs, rollbacks and an audit log. One Rust binary by Teamtem.',
    template: 'splash',
    tableOfContents: false,
    pagefind: false,
  }}
  hasSidebar={false}
>
  <div class="not-content k-landing">
    <!-- Hero -->
    <section class="k-hero k-bleed">
      <div class="k-hero-copy">
        <a class="k-pill k-rise" href="/blog/introducing-kuben/">
          <span class="k-dot"></span>
          Kuben 1.0 is out · read the announcement
          <Icon name="lucide:arrow-right" />
        </a>
        <h1 class="k-rise" data-delay="1">
          A PaaS for your Kubernetes,<br />
          <span class="k-gradient-text">in one binary.</span>
        </h1>
        <p class="k-lead k-rise" data-delay="2">
          Kuben turns any cluster into a platform your team can actually use. Push an image, get an isolated
          environment with HTTPS, autoscaling, logs and rollbacks. One Rust binary, no external database,
          everything a Kubernetes resource.
        </p>
        <div class="k-cta k-rise" data-delay="3">
          <a class="k-btn k-btn-primary" href="/docs/getting-started/quickstart/">
            Get started
            <Icon name="lucide:arrow-right" />
          </a>
          <a class="k-btn k-btn-ghost" href="https://github.com/Teamtem-dev/kuben">
            <Icon name="simple-icons:github" />
            View on GitHub
          </a>
        </div>
        <div class="k-install k-rise" data-delay="3">
          <CopyCommand command={helm} />
          <span class="k-install-note">Kubernetes 1.29+ and Helm. Or <a href="/docs/getting-started/binary/">install the binary</a> on any server.</span>
        </div>
      </div>
      <div class="k-hero-visual k-rise" data-delay="2">
        <ConsoleCard />
      </div>
    </section>

    <!-- Stats -->
    <section class="k-stats" aria-label="Kuben in numbers">
      {
        stats.map((s) => (
          <div class="k-stat">
            <div class="k-stat-value">{s.value}</div>
            <div class="k-stat-label">{s.label}</div>
          </div>
        ))
      }
    </section>

    <!-- Features -->
    <section class="k-section" id="features">
      <div class="k-section-head">
        <div class="k-eyebrow">What you get</div>
        <h2>Everything a small platform team would build, already built.</h2>
        <p>
          Kuben creates the Deployments, Services, autoscalers and HTTPS routes for you and keeps them in
          sync. You keep the cluster, the data and the choice of tooling.
        </p>
      </div>
      <div class="k-features">
        {
          features.map((f) => (
            <article class="k-card k-feature">
              <span class="k-feature-icon">
                <Icon name={f.icon} />
              </span>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <!-- How it works -->
    <section class="k-section k-how" id="how-it-works">
      <div class="k-section-head">
        <div class="k-eyebrow">How it works</div>
        <h2>Three steps from a cluster to a platform.</h2>
      </div>
      <div class="k-steps">
        <div class="k-card k-step">
          <div class="k-step-n">1</div>
          <h3>Install</h3>
          <p>One Helm release inside the cluster, or one binary on a server next to k3s. <code>kuben doctor</code> checks the prerequisites.</p>
        </div>
        <div class="k-card k-step">
          <div class="k-step-n">2</div>
          <h3>Model</h3>
          <p>Create a project and its environments, invite the team with roles, and mint a scoped API token for CI.</p>
        </div>
        <div class="k-card k-step">
          <div class="k-step-n">3</div>
          <h3>Ship</h3>
          <p>Deploy from the UI or <code>PATCH</code> the image from a pipeline. Kuben reconciles the workload, the route and the certificate.</p>
        </div>
      </div>

      <div class="k-flow k-card" aria-label="Request flow">
        <div class="k-flow-node">
          <Icon name="lucide:monitor" />
          <span>Console or REST API</span>
        </div>
        <span class="k-flow-arrow" aria-hidden="true"></span>
        <div class="k-flow-node k-flow-core">
          <Logo id="flow" size={22} />
          <span>api · controller</span>
        </div>
        <span class="k-flow-arrow" aria-hidden="true"></span>
        <div class="k-flow-node">
          <Icon name="simple-icons:kubernetes" />
          <span>Project · Environment · App · Release CRDs</span>
        </div>
        <span class="k-flow-arrow" aria-hidden="true"></span>
        <div class="k-flow-node">
          <Icon name="lucide:boxes" />
          <span>Deployment · Service · HPA · HTTPRoute</span>
        </div>
      </div>
      <p class="k-flow-note">
        The API reads from small in-memory projections, so it answers without talking to the API server.
        With PostgreSQL, several replicas serve the API and one of them, chosen through a Lease, runs the
        controllers. <a href="/docs/getting-started/concepts/">Read the concepts →</a>
      </p>
    </section>

    <!-- Security -->
    <section class="k-section k-security" id="security">
      <div class="k-security-grid">
        <div>
          <div class="k-eyebrow">Secure by default</div>
          <h2>The boring parts are done properly.</h2>
          <p>
            Kuben's service account can manage every tenant namespace, so it is treated like an
            infrastructure controller: minimal image, minimal privileges, and a security model that is
            written down rather than implied.
          </p>
          <a class="k-more" href="/docs/operations/security/">Security model and its limits <Icon name="lucide:arrow-right" /></a>
        </div>
        <ul class="k-checklist">
          {
            security.map((line) => (
              <li>
                <Icon name="lucide:shield-check" />
                <span>{line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Templates -->
    <section class="k-section k-templates" id="templates">
      <div class="k-section-head">
        <div class="k-eyebrow">One-click services</div>
        <h2>Databases and tools, with generated credentials.</h2>
        <p>
          Templates create the app, its volume and a <code>&lt;name&gt;-credentials</code> secret with a random
          password. Apps connect with <code>DATABASE_URL=@db-credentials/url</code>; no password ever appears in a
          spec, a release or the audit log.
        </p>
      </div>
      <div class="k-chips">
        {templates.map((t) => <span class="k-chip">{t}</span>)}
        <a class="k-chip k-chip-link" href="/docs/reference/templates/">All templates →</a>
      </div>
    </section>

    <!-- Roadmap + CTA -->
    <section class="k-section k-roadmap" id="roadmap">
      <div class="k-section-head">
        <div class="k-eyebrow">Next</div>
        <h2>On the roadmap.</h2>
      </div>
      <div class="k-roadmap-grid">
        {
          roadmap.map((r) => (
            <div class="k-card k-road">
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="k-final k-bleed">
      <Logo id="cta" size={44} wordmark={false} />
      <h2>Ready when your cluster is.</h2>
      <p>Apache-2.0. Built in Rust by Teamtem. Runs on k3s, kind, EKS, GKE and AKS.</p>
      <div class="k-cta">
        <a class="k-btn k-btn-primary" href="/docs/getting-started/quickstart/">Read the quickstart</a>
        <a class="k-btn k-btn-ghost" href="https://github.com/Teamtem-dev/kuben">
          <Icon name="lucide:star" /> Star on GitHub
        </a>
      </div>
      <div class="k-install k-install-center">
        <CopyCommand command={curl} />
      </div>
    </section>

    <!-- Site footer -->
    <footer class="k-site-footer">
      <div class="k-foot-brand">
        <Logo id="foot" size={26} />
        <p>A Kubernetes PaaS in a single binary. A <a href="https://teamtem.com">Teamtem</a> project.</p>
      </div>
      <div class="k-foot-cols">
        <div>
          <h4>Product</h4>
          <a href="/docs/">Documentation</a>
          <a href="/docs/getting-started/quickstart/">Quickstart</a>
          <a href="/blog/">Blog</a>
          <a href="/docs/roadmap/">Roadmap</a>
        </div>
        <div>
          <h4>Reference</h4>
          <a href="/docs/reference/cli/">CLI</a>
          <a href="/docs/reference/configuration/">Configuration</a>
          <a href="/docs/reference/helm-values/">Helm chart</a>
          <a href="/docs/reference/api/">REST API</a>
        </div>
        <div>
          <h4>Project</h4>
          <a href="https://github.com/Teamtem-dev/kuben">GitHub</a>
          <a href="https://github.com/Teamtem-dev/kuben/releases">Releases</a>
          <a href="https://github.com/Teamtem-dev/kuben/security/policy">Security policy</a>
          <a href="/docs/contributing/development/">Contributing</a>
        </div>
      </div>
    </footer>
  </div>
</StarlightPage>

<style>
  .k-landing {
    --k-max: 72rem;
  }

  .k-landing h2 {
    font-size: clamp(1.6rem, 1rem + 2vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    color: var(--sl-color-white);
  }

  .k-landing h3 {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }

  .k-landing p {
    color: var(--sl-color-gray-2);
    line-height: 1.65;
  }

  .k-landing code {
    font-family: var(--sl-font-mono);
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    border-radius: 0.4rem;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-white);
  }

  .k-section-head {
    max-width: 44rem;
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2.25rem;
  }

  /* hero */
  .k-hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) clamp(2rem, 5vw, 4rem);
  }

  .k-hero::before {
    background:
      radial-gradient(60% 50% at 30% 0%, var(--k-glow), transparent 70%),
      radial-gradient(40% 40% at 90% 20%, rgb(246 139 18 / 8%), transparent 70%);
  }

  .k-hero-copy {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    min-width: 0;
  }

  .k-hero-copy > * {
    max-width: 100%;
  }

  .k-hero h1 {
    font-size: clamp(2.4rem, 1.2rem + 4.2vw, 4.25rem);
    font-weight: 750;
    letter-spacing: -0.04em;
    line-height: 1.02;
    color: var(--sl-color-white);
  }

  .k-lead {
    font-size: 1.125rem;
    max-width: 36rem;
  }

  .k-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
  }

  a.k-pill {
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  a.k-pill:hover {
    background: var(--k-surface-hover);
    color: var(--sl-color-white);
  }

  .k-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .k-install {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    max-width: 36rem;
    min-width: 0;
  }

  .k-install > * {
    min-width: 0;
  }

  .k-install-note {
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    padding-inline-start: 0.5rem;
  }

  .k-install-note a {
    color: var(--sl-color-text-accent);
    text-decoration: none;
  }

  .k-install-center {
    justify-items: center;
    max-width: 34rem;
  }

  .k-hero-visual {
    position: relative;
  }

  .k-hero-visual::after {
    content: '';
    position: absolute;
    /* Never past the right edge: absolutely positioned boxes extend the page's
       scrollable area to the right and bottom, which showed as a sideways
       wobble on phones. */
    inset: 10% 0 -8% 8%;
    z-index: -1;
    background: radial-gradient(closest-side, var(--k-glow), transparent);
    filter: blur(30px);
  }

  @media (min-width: 60rem) {
    .k-hero {
      grid-template-columns: 1.15fr 1fr;
      gap: 4rem;
    }
  }

  /* stats */
  .k-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    border-radius: var(--k-radius-lg);
    overflow: hidden;
    background: var(--k-line);
    border: 1px solid var(--k-line);
  }

  .k-stat {
    background: var(--sl-color-bg);
    padding: 1.4rem 1.5rem;
  }

  .k-stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }

  .k-stat-label {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.2rem;
  }

  @media (min-width: 50rem) {
    .k-stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* features */
  .k-features {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .k-feature {
    padding: 1.5rem;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }

  .k-feature p {
    font-size: 0.9375rem;
  }

  .k-feature-icon {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent);
    color: var(--sl-color-accent);
  }

  .k-feature-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* how it works */
  .k-steps {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    margin-bottom: 1.5rem;
  }

  .k-step {
    padding: 1.5rem;
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .k-step p {
    font-size: 0.9375rem;
  }

  .k-step-n {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: var(--sl-color-bg-accent);
    color: var(--sl-color-text-invert);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .k-flow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .k-flow-node {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    background: var(--k-surface);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .k-flow-node :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--sl-color-accent);
    flex: none;
  }

  .k-flow-core {
    background: color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }

  .k-flow-arrow {
    width: 1.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--sl-color-gray-4));
    position: relative;
  }

  .k-flow-arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--sl-color-gray-4);
    border-right: 1px solid var(--sl-color-gray-4);
    transform: rotate(45deg);
  }

  .k-flow-note {
    margin-top: 1rem;
    font-size: 0.9375rem;
    max-width: 52rem;
  }

  .k-flow-note a,
  .k-more {
    color: var(--sl-color-text-accent);
    text-decoration: none;
    font-weight: 500;
  }

  .k-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .k-more :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* security */
  .k-security-grid {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .k-security-grid > div {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .k-checklist {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 0;
    display: grid;
    gap: 0.6rem;
  }

  .k-checklist li {
    display: flex;
    gap: 0.8rem;
    padding: 0.9rem 1.1rem;
    border-radius: var(--k-radius);
    background: var(--k-surface);
    color: var(--sl-color-gray-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .k-checklist :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    flex: none;
    color: var(--sl-color-accent);
    margin-top: 0.15rem;
  }

  @media (min-width: 60rem) {
    .k-security-grid {
      grid-template-columns: 1fr 1.3fr;
      gap: 4rem;
    }
  }

  /* templates */
  .k-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .k-chip {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--k-surface);
    border: 1px solid var(--k-line);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }

  .k-chip-link {
    text-decoration: none;
    color: var(--sl-color-text-accent);
    background: transparent;
  }

  .k-chip-link:hover {
    background: var(--k-surface);
  }

  /* roadmap */
  .k-roadmap-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }

  .k-road {
    padding: 1.25rem 1.4rem;
    display: grid;
    gap: 0.4rem;
  }

  .k-road p {
    font-size: 0.9rem;
  }

  /* final CTA */
  .k-final {
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .k-final::before {
    background: radial-gradient(50% 60% at 50% 100%, var(--k-glow), transparent 70%);
  }

  .k-final p {
    max-width: 36rem;
  }

  .k-final .k-cta {
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* footer */
  .k-site-footer {
    display: grid;
    gap: 2rem;
    padding: 2.5rem 0 1rem;
    border-top: 1px solid var(--k-line);
  }

  .k-foot-brand {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 22rem;
  }

  .k-foot-brand p {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
  }

  .k-foot-brand a,
  .k-foot-cols a {
    color: inherit;
    text-decoration: none;
  }

  .k-foot-cols {
    display: grid;
