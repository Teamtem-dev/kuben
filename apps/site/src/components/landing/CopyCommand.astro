---
/** A one-line shell command with a copy button, for the hero and CTA blocks. */
interface Props {
  command: string
  label?: string
}

const { command, label = 'Copy command' } = Astro.props
---

<copy-command class="k-copy not-content">
  <span class="k-prompt" aria-hidden="true">$</span>
  <code>{command}</code>
  <button type="button" aria-label={label} data-command={command}>
    <svg class="k-ico-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="3"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="k-ico-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </button>
</copy-command>

<style>
  .k-copy {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--k-line);
    background: var(--k-surface);
    font-family: var(--sl-font-mono);
    font-size: 0.8125rem;
  }

  .k-prompt {
    color: var(--sl-color-accent);
    flex: none;
  }

  code {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    color: var(--sl-color-white);
    scrollbar-width: none;
  }

  button {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 0;
    background: var(--k-surface-strong);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  button:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 22%, transparent);
    color: var(--sl-color-white);
  }

  .k-ico-done,
  [data-copied] .k-ico-copy {
    display: none;
  }

  [data-copied] .k-ico-done {
    display: block;
    color: #4ade80;
  }
</style>

<script>
  class CopyCommand extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector('button')
      if (!button) return
      button.addEventListener('click', async () => {
        const text = button.dataset.command ?? ''
        try {
          await navigator.clipboard.writeText(text)
          this.setAttribute('data-copied', '')
          setTimeout(() => this.removeAttribute('data-copied'), 1600)
        } catch {
          /* Clipboard unavailable (insecure context): the text stays selectable. */
        }
      })
    }
  }
  customElements.define('copy-command', CopyCommand)
</script>
