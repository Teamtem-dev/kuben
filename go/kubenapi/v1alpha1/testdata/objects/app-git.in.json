{"apiVersion":"kuben.dev/v1alpha1","kind":"App","metadata":{"name":"shop","namespace":"kb-shop-dev"},
 "spec":{
  "source": { "git": { "repo": "https://github.com/acme/shop", "branch": "main" } },
  "runtime": { "processes": { "web": { "port": 8080, "replicas": { "min": 2, "max": 4 } } } },
  "env": [ { "name": "LOG_LEVEL", "value": "info" } ],
  "domains": [ { "host": "api.acme.com" } ],
  "volumes": [ { "name": "data", "mountPath": "/data" } ]
 }}
