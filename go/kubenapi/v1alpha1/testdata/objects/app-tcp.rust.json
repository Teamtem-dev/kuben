{
  "apiVersion": "kuben.dev/v1alpha1",
  "kind": "App",
  "metadata": {
    "name": "db",
    "namespace": "kb-shop-dev"
  },
  "spec": {
    "source": {
      "image": "postgres:17-alpine"
    },
    "runtime": {
      "processes": {
        "backup": {
          "size": "small",
          "replicas": {
            "min": 1,
            "max": 1
          },
          "schedule": "0 3 * * *",
          "timeZone": "Europe/Berlin"
        },
        "db": {
          "port": 5432,
          "size": "small",
          "replicas": {
            "min": 1,
            "max": 1
          },
          "protocol": "tcp"
        }
      }
    }
  }
}
