+			{"apiVersion":"gateway.networking.k8s.io/v1","kind":"HTTPRoute",
+			 "metadata":{"name":"web","namespace":"other"},"spec":{"hostnames":["web.example.com"]}}]`),
+		Secrets: []store.SecretReference{{Name: "db", Revision: 4, Kind: "opaque"}},
