{
  "apiVersion": "kuben.dev/v1alpha1",
  "kind": "App",
  "metadata": {
    "name": "api",
    "namespace": "kb-shop-prod"
  },
  "spec": {
    "source": {
      "image": "busybox@sha256:2222222222222222222222222222222222222222222222222222222222222222"
    },
    "runtime": {
      "processes": {
        "tick": {
          "command": [
            "sh",
            "-c",
            "echo tick"
          ],
          "size": "nano",
          "replicas": {
            "min": 1,
            "max": 1
          },
          "schedule": "*/30 * * * *"
        }
      }
    }
  }
}
